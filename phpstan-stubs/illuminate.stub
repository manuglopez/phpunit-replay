<?php

// The two Laravel classes `Laravel\TrackersServiceProvider` and its subscriber name. The package
// does not depend on illuminate/*: these are only for static analysis.

namespace Illuminate\Support;

abstract class ServiceProvider
{
    /** @var object */
    protected $app;

    /** @param object $app */
    public function __construct($app)
    {
    }
}

namespace Illuminate\Foundation\Bootstrap;

class RegisterProviders
{
    /** @var string|null */
    protected static $bootstrapProviderPath;

    /** @param list<string> $providers */
    public static function merge(array $providers, ?string $bootstrapProviderPath = null): void
    {
    }
}

namespace Illuminate\Translation;

// The part of Laravel's translator `Laravel\RecordingTranslator` extends: `get()`'s signature as
// Illuminate declares it, and the protected `localeArray()` that honours `determineLocalesUsing()`.
class Translator
{
    /** @var string */
    protected $locale;

    /**
     * @param string $key
     * @param array<string, mixed> $replace
     * @param string|null $locale
     * @param bool $fallback
     * @return string|array<mixed>
     */
    public function get($key, array $replace = [], $locale = null, $fallback = true)
    {
        return '';
    }

    /** @return string */
    public function getLocale()
    {
        return '';
    }

    /**
     * @param string|null $locale
     * @return array<int, string>
     */
    protected function localeArray($locale)
    {
        return [];
    }
}
